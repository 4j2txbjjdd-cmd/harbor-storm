# Copy to .env and fill in. .env is gitignored; .env.example is not.
# Never commit a real key.

# --- Weather -------------------------------------------------------
# Google Weather API key, used by GoogleWeatherProvider against
# forecast/hours:lookup. Required for any live run: the provider refuses
# to start without it rather than degrading to an empty forecast.
# GOOGLE_MAPS_API_KEY is accepted as a fallback name.
GOOGLE_WEATHER_API_KEY=

# --- Sites ---------------------------------------------------------
# Optional. Overrides the built-in coordinates for the symbolic site
# names the scenarios use. Defaults: PORT_A/WH_A (Rotterdam pair,
# StormSlot), HARBOR_A/ISLAND_B (Piraeus/Aegina pair, HarborWindow).
# SITES_JSON={"PORT_A":{"lat":51.9497,"lng":4.1399}}

# --- Firestore -----------------------------------------------------
# Set to run the store contract suite against the emulator instead of
# real Firestore. Requires a JDK and firebase-tools; without it the 47
# Firestore contract params skip.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_CLOUD_PROJECT=harbor-storm-local
